<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <LinearLayout
        android:id="@+id/top_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:background="@drawable/bg_player_control_top"
        android:animateLayoutChanges="true"
        android:orientation="vertical"
        android:paddingHorizontal="5dp"
        android:paddingBottom="10dp"
        android:paddingTop="5dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="4dp"
            android:layoutDirection="ltr">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layoutDirection="ltr">

                <ImageView
                    android:id="@+id/close_imageButton"
                    style="@style/PlayerControlTop"
                    android:src="@drawable/ic_close"
                    android:tooltipText="@string/tooltip_minimize"
                    app:tint="@android:color/white" />

                <ImageView
                    android:id="@+id/lock_player"
                    style="@style/PlayerControlTop"
                    android:scaleX="0.75"
                    android:scaleY="0.75"
                    android:src="@drawable/ic_unlocked" />

            </LinearLayout>

            <TextView
                android:id="@+id/exo_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginHorizontal="10dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@android:color/white"
                android:textSize="16sp"
                android:visibility="invisible" />

            <LinearLayout
                android:id="@+id/exo_top_bar_right"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:layoutDirection="ltr">

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/autoPlay"
                    android:layout_width="wrap_content"
                    android:layout_height="33dp"
                    android:scaleX="0.6"
                    android:scaleY="0.6"
                    android:thumb="@drawable/player_switch_thumb"
                    android:tooltipText="@string/player_autoplay"
                    app:thumbTint="@android:color/white"
                    app:track="@drawable/player_switch_track"
                    app:trackTint="#88ffffff" />

                <ImageButton
                    android:id="@+id/dearrow_submit"
                    style="@style/PlayerControlTop"
                    android:layout_marginEnd="2dp"
                    android:src="@drawable/ic_dearrow"
                    android:scaleX="0.8"
                    android:scaleY="0.8"
                    android:tooltipText="@string/contribute_to_dearrow"
                    android:visibility="gone"
                    app:tint="@android:color/white"
                    tools:visibility="visible"
                    />

                <ImageButton
                    android:id="@+id/sb_submit"
                    style="@style/PlayerControlTop"
                    android:src="@drawable/ic_upload_segment"
                    android:tooltipText="@string/sb_create_segment"
                    android:visibility="gone"
                    app:tint="@android:color/white" />

                <ImageButton
                    android:id="@+id/sb_toggle"
                    style="@style/PlayerControlTop"
                    android:src="@drawable/ic_sb_enabled"
                    android:tooltipText="@string/tooltip_sponsorblock"
                    android:visibility="gone"
                    app:tint="@android:color/white" />

                <ImageButton
                    android:id="@+id/queue_toggle"
                    style="@style/PlayerControlTop"
                    android:src="@drawable/ic_queue"
                    android:tooltipText="@string/queue"
                    app:tint="@android:color/white" />

                <ImageButton
                    android:id="@+id/toggle_options"
                    style="@style/PlayerControlTop"
                    android:src="@drawable/ic_player_settings"
                    android:tooltipText="@string/tooltip_options"
                    android:scaleX="0.8"
                    android:scaleY="0.8"
                    app:tint="@android:color/white" />

            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

    <LinearLayout
        android:id="@id/exo_center_controls"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center"
        android:layoutDirection="ltr">

        <include
            android:id="@+id/seek_button_rewind"
            layout="@layout/seek_button_rewind"
            android:visibility="gone"
            tools:visibility="visible" />

        <ImageView
            android:id="@+id/skip_prev"
            style="@style/PlayerControlCenter"
            android:src="@drawable/ic_prev"
            app:tint="@android:color/white" />

        <ImageButton
            android:id="@+id/playPauseBTN"
            style="@style/ExoStyledControls.Button.Center.PlayPause"
            android:background="@drawable/bg_player_control_btn"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:layout_marginHorizontal="18dp"
            android:src="@drawable/ic_play"
            android:scaleType="fitCenter"
            android:padding="6dp"
            app:tint="@android:color/white"
            android:translationZ="5dp"
            />

        <ImageView
            android:id="@+id/skip_next"
            style="@style/PlayerControlCenter"
            android:src="@drawable/ic_next"
            app:tint="@android:color/white" />

        <include
            android:id="@+id/seek_button_forward"
            layout="@layout/seek_button_forward"
            android:visibility="gone"
            tools:visibility="visible" />

    </LinearLayout>

    <LinearLayout
        android:paddingTop="10dp"
        android:id="@+id/bottom_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_marginTop="10dp"
        android:orientation="vertical"
        android:background="@drawable/bg_player_control_bottom">

        <LinearLayout
            android:id="@+id/seekbar_preview"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:translationY="0dp"
            android:translationZ="1dp"
            android:visibility="gone"
            tools:visibility="visible"
            >

            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/seekbar_preview_image"
                android:layout_width="140dp"
                android:layout_height="wrap_content"
                android:maxHeight="100dp"
                android:adjustViewBounds="true"
                android:scaleType="fitCenter"
                app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Small" />

            <com.google.android.material.progressindicator.LinearProgressIndicator
                android:id="@+id/previewProgressIndicator"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="?shapeCornerSizeSmall"
                android:layout_gravity="bottom"
                android:indeterminate="true"
                android:visibility="invisible"
                app:trackThickness="2.5dp" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginTop="5dp"
                android:padding="5dp"
                app:strokeWidth="0dp">

                <TextView
                    android:id="@+id/seekbar_preview_position"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="5dp" />

            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>

        <LinearLayout
            android:id="@+id/bottom_bar_progress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:paddingHorizontal="5dp"
            android:orientation="horizontal">

            <com.github.libretube.ui.views.ChapterTimeBar
                android:id="@+id/exo_progress"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                app:bar_height="2dp"
                app:scrubber_drawable="@drawable/player_timebar_scrubber"
                app:played_color="?attr/colorPrimary"
                app:buffered_color="#88FFFFFF"
                app:unplayed_color="#33FFFFFF"
                app:scrubber_color="?attr/colorPrimary"
                app:scrubber_dragged_size="0dp"
                app:scrubber_enabled_size="0dp"
                app:touch_target_height="38dp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/bottom_bar_controls"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="-8dp"
            android:paddingBottom="4dp"
            android:gravity="center_vertical"
            android:baselineAligned="false"
            android:paddingHorizontal="5dp">

            <LinearLayout
                android:id="@id/exo_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp">
                <TextView
                    android:id="@+id/position"
                    style="@style/TimeString"
                    android:text="00:00"
                    tools:ignore="HardcodedText" />

                <TextView
                    style="@style/TimeString"
                    android:text=" / "
                    tools:ignore="HardcodedText" />
                <TextView
                    android:id="@+id/duration"
                    style="@style/TimeString"
                    android:text="00:00"
                    tools:ignore="HardcodedText" />

                <TextView
                    android:id="@+id/timeLeft"
                    style="@style/TimeString"
                    android:text="00:00"
                    android:visibility="gone"
                    tools:ignore="HardcodedText" />
            </LinearLayout>

            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="6dp"
                android:layout_weight="1">

                <TextView
                    android:id="@+id/chapter_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:gravity="center_vertical"
                    android:maxLines="1"
                    android:textColor="@android:color/white"
                    android:visibility="gone"
                    android:layout_marginStart="8dp"
                    app:drawableEndCompat="@drawable/ic_arrow_right"
                    app:drawableTint="@android:color/white"
                    tools:drawableTint="?colorControlNormal"
                    tools:text="some overflowing text that takes too much space"
                    tools:textColor="@android:color/black"
                    tools:visibility="visible" />

            </FrameLayout>

            <LinearLayout
                android:id="@id/exo_basic_controls"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">

                <ImageButton
                    android:id="@+id/qualityBtn"
                    style="@style/PlayerControlBottom"
                    android:src="@drawable/ic_hd"
                    android:tooltipText="@string/quality"
                    android:visibility="visible"
                    app:tint="@android:color/white"
                    tools:visibility="visible"/>

                <ImageButton
                    android:id="@+id/captionsBtn"
                    style="@style/PlayerControlBottom"
                    android:src="@drawable/ic_caption"
                    android:tooltipText="@string/captions"
                    android:visibility="visible"
                    app:tint="@android:color/white"
                    tools:visibility="visible"/>

                <ImageButton
                    android:id="@+id/fullscreen"
                    style="@style/PlayerControlBottom"
                    android:src="@drawable/ic_fullscreen"
                    android:tooltipText="@string/tooltip_fullscreen"
                    app:tint="@android:color/white" />

            </LinearLayout>

        </LinearLayout>
    </LinearLayout>

</merge>
